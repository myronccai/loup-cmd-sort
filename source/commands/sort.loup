@mode(host.dual)

# sort itself: read every input into one byte table, sort its line numbers
# with a stable merge sort and the line comparator, drop equal runs for -u,
# and write the lines; or, for -c/-C, find the first line out of order.
# Only run_sort prints; everything else returns values.
#
# Runtime: host.dual. Compiled into the native binary build/sort by `make
# build`; `make run` interprets the same code with `loup-bootstrap run`.
# The unit tests sort strings through sort_text.

from io.fs import (isDir);
from io.path import (dirname);
from appinfo import (APP_NAME, EXIT_OK, EXIT_DISORDER, EXIT_TROUBLE);
from cli.args import (Options);
from commands.table import (Table, new_table, line_count, append_bytes, append_text, push_line);
from commands.compare import (Comparer, compare_lines);
from commands.mergesort import (merge_sort);
from commands.output import (write_stdout, write_file, text_of);

# The comparator settings for `t` under `opts`. -s and -u turn off the
# last-resort comparison of whole lines.
pub func comparer_for(t: Table, opts: Options): Comparer {
    return Comparer.build(t, opts.keys, opts.tab, !(opts.distinct or opts.stable), opts.reverse);
}

# The line numbers of `t` in sorted order.
pub func sorted_lines(t: Table, c: Comparer): list[int] {
    return merge_sort(line_count(t), func(a: int, b: int): int {
        return compare_lines(t, c, a, b);
    });
}

# The first line of each run of lines that compare equal (-u). `order` is
# sorted, so equal lines are next to each other.
pub func unique_lines(t: Table, c: Comparer, order: list[int]): list[int] {
    var out: list[int] = [];
    for (i in order) {
        if (out.len() == 0 or compare_lines(t, c, out[-1], i) != 0) {
            out.push(i);
        }
    }
    return out;
}

# The bytes of the lines `order` of `t`, each ending with a newline.
pub func render(t: Table, order: list[int]): list[int] {
    var out: list[int] = [];
    for (i in order) {
        push_line(edits: out, t, i);
    }
    return out;
}

# The sorted output for the lines of `t`, as bytes.
pub func sort_table(t: Table, opts: Options): list[int] {
    let c = comparer_for(t, opts);
    var order = sorted_lines(t, c);
    if (opts.distinct) {
        order = unique_lines(t, c, order);
    }
    return render(t, order);
}

# Sorts `text` (as one input) and returns the output. For the unit tests.
pub func sort_text(text: string, opts: Options): string {
    let t = new_table();
    append_text(edits: t, text);
    return text_of(sort_table(t, opts));
}

# The 1-based number of the first line that sorts before the line above it
# (with `strict`, for -u, also one equal to it), or 0 if the lines are in
# order.
pub func first_disorder(t: Table, c: Comparer, strict: bool): int {
    let limit = if (strict) { 0 } else { 1 };
    let n = line_count(t);
    var i = 1;
    while (i < n) {
        if (compare_lines(t, c, i - 1, i) >= limit) {
            return i + 1;
        }
        i += 1;
    }
    return 0;
}

# Line `i` of `t` without its newline, as text for a message.
pub func line_text(t: Table, i: int): string {
    var line: list[int] = [];
    push_line(edits: line, t, i);
    line.pop();
    return text_of(line);
}

# Why the -o file cannot be opened, or None if it looks writable.
pub func output_problem(path: string): string? {
    if (path == "") {
        return Some("No such file or directory");
    }
    if (isDir(path)) {
        return Some("Is a directory");
    }
    if (!isDir(dirname(path))) {
        return Some("No such file or directory");
    }
    return None;
}

func fail(message: string): int {
    printErr(APP_NAME + ": " + message);
    return EXIT_TROUBLE;
}

pub func run_sort(opts: Options): int {
    var files = opts.files;
    if (files.len() == 0) {
        files = ["-"];
    }
    let checking = opts.check != "";

    # Like GNU, make sure every input exists and the output can be opened
    # before reading anything. (The native runtime cannot catch the IoError
    # a missing file would raise.)
    for (f in files) {
        if (f != "-" and !exists(f)) {
            let what = if (checking) { "open failed" } else { "cannot read" };
            return fail(what + ": " + f + ": No such file or directory");
        }
    }
    if (opts.has_output) {
        let problem = output_problem(opts.output);
        if (problem.is_some()) {
            return fail("open failed: " + opts.output + ": " + problem.unwrap());
        }
    }

    let t = new_table();
    for (f in files) {
        if (f != "-" and isDir(f)) {
            return fail("read failed: " + f + ": Is a directory");
        }
        let data = readBytes(if (f == "-") { "/dev/stdin" } else { f });
        append_bytes(edits: t, data);
    }

    if (checking) {
        let bad = first_disorder(t, comparer_for(t, opts), opts.distinct);
        if (bad == 0) {
            return EXIT_OK;
        }
        if (opts.check == "c") {
            printErr(APP_NAME + ": " + files[0] + ":" + str(bad) + ": disorder: " + line_text(t, bad - 1));
        }
        return EXIT_DISORDER;
    }

    let out = sort_table(t, opts);
    if (opts.has_output) {
        write_file(opts.output, out);
    } else {
        write_stdout(out);
    }
    return EXIT_OK;
}

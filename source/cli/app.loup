@mode(host.dual)

from appinfo import (APP_NAME, EXIT_OK, EXIT_TROUBLE);
from cli.args import (Options, ArgError, parse_args);
from cli.usage import (usage, version_line);
from commands.sort import (run_sort);

# Parses argv, runs sort and returns the exit status.
pub func run(argv: list[string]): int {
    let opts = match parse_args(argv) {
        Ok(parsed) => parsed,
        Err(e) => {
            return report(e);
        },
    };

    if (opts.help) {
        println(usage());
        return EXIT_OK;
    }
    if (opts.version) {
        println(version_line());
        return EXIT_OK;
    }

    try {
        return run_sort(opts);
    } catch (Exception as e) {
        printErr(APP_NAME + ": " + e.message);
        return EXIT_TROUBLE;
    }
}

func report(e: ArgError): int {
    printErr(APP_NAME + ": " + e.message);
    if (e.try_help) {
        printErr(i"Try '{$ APP_NAME $} --help' for more information.");
    }
    return e.status;
}

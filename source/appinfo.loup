@mode(host.dual)

# Application identity for sort: name, version, summary and exit statuses.
# Keep APP_NAME and APP_VERSION in step with `name` and `version` in
# package.lppkg.
#
# Runtime: host.dual. Constants only. Compiled into build/sort by `make
# build`; `make run` interprets the same code with `loup-bootstrap run`.

pub const APP_NAME: string = "sort";
pub const APP_VERSION: string = "0.1.0";
pub const APP_SUMMARY: string = "Sort lines of text files (a Loup recreation of GNU sort).";

# Exit statuses returned by main(), as GNU sort uses them.
pub const EXIT_OK: int = 0;
# -c / -C found a line out of order.
pub const EXIT_DISORDER: int = 1;
# Usage errors, unreadable inputs, unwritable output.
pub const EXIT_TROUBLE: int = 2;

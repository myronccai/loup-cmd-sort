@mode(host.dual)

# Unit tests for the exit statuses of the whole command line (cli.app.run):
# help, version, sorting a fixture, -c/-C, usage errors and a missing
# input. These tests print the program's normal output and messages.
#
# Runtime: host.dual, run by the test runner: `make test` interprets this
# file with Stage0 (`loup-bootstrap test --no-parallel`, source/ on
# LOUPPATH), one test per `func test_*()`. It is not part of the binary.

from debug.assert import (expectEq);
from appinfo import (EXIT_OK, EXIT_DISORDER, EXIT_TROUBLE);
from cli.app import (run);

func test_version_succeeds(): void {
    expectEq(run(["--version"]), EXIT_OK, "--version");
}

func test_help_succeeds(): void {
    expectEq(run(["--help"]), EXIT_OK, "--help");
}

func test_sort_file_succeeds(): void {
    expectEq(run(["-t:", "-k2,2n", "tests/fixtures/scores.txt"]), EXIT_OK, "sort a file");
}

func test_check_statuses(): void {
    expectEq(run(["-c", "tests/fixtures/sorted.txt"]), EXIT_OK, "sorted");
    expectEq(run(["-C", "tests/fixtures/scores.txt"]), EXIT_DISORDER, "not sorted");
}

func test_usage_errors(): void {
    expectEq(run(["-x"]), EXIT_TROUBLE, "invalid option");
    expectEq(run(["-k", "0"]), EXIT_TROUBLE, "bad key");
    expectEq(run(["--check=loud"]), 1, "bad --check word");
}

func test_missing_input(): void {
    expectEq(run(["tests/fixtures/no-such-file"]), EXIT_TROUBLE, "missing file");
    expectEq(run(["tests/fixtures"]), EXIT_TROUBLE, "directory");
}
